<!doctype html>
<html lang="de">
<head>
<meta charset="utf-8">
<meta name="viewport" content="width=device-width, initial-scale=1">
<title>Virtueller Versuch – Redoxreihe der Metalle</title>
<style>
  :root{
    --bg:#f5f7fa;
    --card:#ffffff;
    --ink:#172033;
    --muted:#667085;
    --line:#d8dee8;
    --accent:#2b59c3;
    --accent2:#173b8f;
    --ok:#16794f;
    --warn:#9a6700;
    --shadow:0 10px 30px rgba(23,32,51,.08);
  }
  *{box-sizing:border-box}
  body{
    margin:0;
    font-family:Inter, ui-sans-serif, system-ui, -apple-system, BlinkMacSystemFont, "Segoe UI", sans-serif;
    color:var(--ink);
    background:
      radial-gradient(circle at 10% 0%, #eaf0ff 0, transparent 27rem),
      var(--bg);
  }
  .page{max-width:1180px;margin:auto;padding:28px 20px 44px}
  header{
    display:flex;justify-content:space-between;gap:20px;align-items:flex-start;
    margin-bottom:18px
  }
  h1{font-size:clamp(1.65rem,3vw,2.45rem);margin:.15rem 0 .4rem;line-height:1.08}
  .eyebrow{font-weight:800;letter-spacing:.08em;text-transform:uppercase;font-size:.78rem;color:var(--accent)}
  .sub{color:var(--muted);max-width:760px;line-height:1.55}
  .badge{background:#101828;color:#fff;border-radius:999px;padding:8px 12px;font-size:.82rem;font-weight:800;white-space:nowrap}
  .grid{display:grid;grid-template-columns:320px 1fr;gap:18px}
  .card{background:var(--card);border:1px solid var(--line);border-radius:18px;box-shadow:var(--shadow)}
  .controls{padding:18px}
  .controls h2,.lab h2,.notes h2{font-size:1rem;margin:0 0 12px}
  .section{padding:15px 0;border-top:1px solid #edf0f4}
  .section:first-of-type{border-top:0;padding-top:4px}
  .section-title{font-size:.8rem;font-weight:800;color:var(--muted);text-transform:uppercase;letter-spacing:.06em;margin-bottom:9px}
  .options{display:grid;gap:8px}
  button.choice{
    border:1px solid var(--line);background:#fff;border-radius:12px;padding:10px 12px;
    text-align:left;cursor:pointer;font-weight:750;color:var(--ink);transition:.15s;
    display:flex;align-items:center;justify-content:space-between;gap:10px
  }
  button.choice:hover{border-color:#9db0db;transform:translateY(-1px)}
  button.choice.active{border-color:var(--accent);box-shadow:0 0 0 3px rgba(43,89,195,.12);background:#f7f9ff}
  .dot{width:18px;height:18px;border-radius:50%;border:1px solid rgba(0,0,0,.18);flex:0 0 auto}
  .metal-dot{border-radius:4px;height:10px;width:34px}
  .action-row{display:grid;grid-template-columns:1fr 1fr;gap:8px}
  .primary,.secondary,.ghost{
    border:0;border-radius:12px;padding:11px 13px;font-weight:800;cursor:pointer;
  }
  .primary{background:var(--accent);color:white}
  .primary:hover{background:var(--accent2)}
  .secondary{background:#e9eefb;color:#173b8f}
  .ghost{background:#f2f4f7;color:#344054}
  .primary:disabled{opacity:.45;cursor:not-allowed}
  .lab{padding:18px;overflow:hidden}
  .stage{
    position:relative;min-height:470px;border:1px solid var(--line);border-radius:16px;
    background:linear-gradient(#fbfcff,#f3f6fa);overflow:hidden
  }
  .bench{position:absolute;left:0;right:0;bottom:0;height:80px;background:linear-gradient(#dde3ea,#c9d1da)}
  .beaker-wrap{position:absolute;left:50%;top:58%;transform:translate(-50%,-50%);width:330px;height:360px}
  .beaker{
    position:absolute;left:44px;right:44px;bottom:34px;height:270px;
    border:5px solid rgba(111,129,150,.65);border-top:0;border-radius:0 0 34px 34px;
    overflow:hidden;background:rgba(255,255,255,.12);
    box-shadow:inset 0 0 0 2px rgba(255,255,255,.6), 0 12px 30px rgba(30,41,59,.08);
  }
  .rim{
    position:absolute;left:34px;right:34px;bottom:298px;height:20px;border:5px solid rgba(111,129,150,.65);
    border-radius:50%;background:rgba(255,255,255,.38);z-index:6
  }
  .liquid{
    position:absolute;left:0;right:0;bottom:0;height:72%;
    background:rgba(222,231,241,.65);transition:background 2.6s ease;
  }
  .surface{position:absolute;left:0;right:0;top:-7px;height:14px;border-radius:50%;background:rgba(255,255,255,.28);border:1px solid rgba(72,92,120,.16)}
  .strip{
    position:absolute;left:50%;top:34px;transform:translateX(-50%);width:58px;height:220px;
    border-radius:5px 5px 12px 12px;z-index:5;border:1px solid rgba(0,0,0,.22);
    box-shadow:inset 0 0 18px rgba(255,255,255,.35), 0 6px 12px rgba(0,0,0,.1);
    transition:background .4s;
  }
  .strip::before{
    content:"";position:absolute;left:8px;top:0;bottom:0;width:8px;background:rgba(255,255,255,.22);
    border-radius:6px;filter:blur(1px)
  }
  .deposit{position:absolute;inset:0;pointer-events:none}
  .speck{position:absolute;border-radius:50%;opacity:0;transform:scale(.2);animation:grow .7s forwards}
  @keyframes grow{to{opacity:.95;transform:scale(1)}}
  .label{
    position:absolute;left:50%;top:8px;transform:translateX(-50%);
    background:#fff;border:1px solid var(--line);border-radius:999px;padding:7px 12px;font-weight:800;font-size:.86rem;
    box-shadow:0 4px 16px rgba(0,0,0,.06);white-space:nowrap
  }
  .timer{
    position:absolute;right:16px;top:16px;background:#101828;color:#fff;border-radius:10px;padding:8px 10px;
    font-variant-numeric:tabular-nums;font-weight:800;font-size:.86rem
  }
  .status{
    position:absolute;left:16px;bottom:15px;right:16px;background:rgba(255,255,255,.92);
    border:1px solid var(--line);border-radius:12px;padding:10px 12px;min-height:46px;
    color:#344054;font-size:.92rem;line-height:1.38;backdrop-filter:blur(8px)
  }
  .progress{height:6px;background:#e5e9f0;border-radius:999px;overflow:hidden;margin-top:8px}
  .progress > div{height:100%;width:0;background:var(--accent);transition:width .08s linear}
  .particle-card{margin-top:14px;border:1px solid var(--line);border-radius:14px;overflow:hidden}
  .particle-head{padding:10px 12px;background:#f8fafc;display:flex;justify-content:space-between;align-items:center;gap:10px}
  .particle-head strong{font-size:.88rem}
  .particle-head span{font-size:.78rem;color:var(--muted)}
  canvas{display:block;width:100%;height:230px;background:#fbfdff}
  .result{
    margin-top:14px;border:1px solid var(--line);border-radius:14px;padding:12px 14px;background:#fff;
  }
  .result strong{display:block;margin-bottom:6px}
  .obs{line-height:1.48;color:#344054}
  .equations{display:none;margin-top:10px;padding-top:10px;border-top:1px dashed var(--line);font-family:"Segoe UI",sans-serif}
  .equations.show{display:block}
  .eq{background:#f7f9fc;border-radius:10px;padding:8px 10px;margin:6px 0}
  .tiny{font-size:.78rem;color:var(--muted);line-height:1.45}
  .notes{margin-top:18px;padding:18px}
  .matrix-wrap{overflow:auto}
  table{width:100%;border-collapse:separate;border-spacing:0;min-width:650px}
  th,td{border-right:1px solid var(--line);border-bottom:1px solid var(--line);padding:9px;text-align:center}
  th:first-child,td:first-child{border-left:1px solid var(--line);text-align:left}
  thead th{border-top:1px solid var(--line);background:#f8fafc}
  thead th:first-child{border-radius:10px 0 0 0}
  thead th:last-child{border-radius:0 10px 0 0}
  .cell-btn{border:1px solid #cfd6df;background:#fff;border-radius:9px;padding:6px 12px;cursor:pointer;font-weight:900;min-width:42px}
  .cell-btn[data-v="+"]{background:#ecfdf3;border-color:#a6e1bf;color:#087443}
  .cell-btn[data-v="-"]{background:#f2f4f7;color:#475467}
  textarea{width:100%;min-height:78px;border:1px solid var(--line);border-radius:12px;padding:10px;resize:vertical;font:inherit}
  .legend{display:flex;gap:14px;flex-wrap:wrap;font-size:.8rem;color:var(--muted);margin-top:10px}
  .legend span{display:flex;align-items:center;gap:6px}
  .mini-ion{width:14px;height:14px;border-radius:50%;display:inline-block;border:1px solid rgba(0,0,0,.16)}
  @media(max-width:860px){
    .grid{grid-template-columns:1fr}
    header{flex-direction:column}
    .stage{min-height:440px}
    .beaker-wrap{transform:translate(-50%,-51%) scale(.9)}
  }
</style>
</head>
<body>
<div class="page">
  <header>
    <div>
      <div class="eyebrow">Station 6 · Virtueller Versuch</div>
      <h1>Die Redoxreihe der Metalle</h1>
      <div class="sub">Untersuche, welche Metallbleche mit welchen Metallsalzlösungen reagieren. Beobachte zuerst nur die sichtbaren Veränderungen. Die Teilchenebene und Reaktionsgleichungen kannst du anschließend gezielt einblenden.</div>
    </div>
    <div class="badge">Zn · Fe · Cu · Ag</div>
  </header>

  <div class="grid">
    <aside class="card controls">
      <h2>Versuch aufbauen</h2>

      <div class="section">
        <div class="section-title">1 · Metallblech wählen</div>
        <div class="options" id="metalOptions"></div>
      </div>

      <div class="section">
        <div class="section-title">2 · Metallsalzlösung wählen</div>
        <div class="options" id="solutionOptions"></div>
      </div>

      <div class="section">
        <div class="section-title">3 · Durchführen</div>
        <div class="action-row">
          <button class="primary" id="startBtn" disabled>Versuch starten</button>
          <button class="ghost" id="resetBtn">Zurücksetzen</button>
        </div>
      </div>

      <div class="section">
        <div class="section-title">Auswertung</div>
        <div class="action-row">
          <button class="secondary" id="particleBtn">Teilchenebene</button>
          <button class="secondary" id="equationBtn">Gleichungen</button>
        </div>
        <p class="tiny">Die Auswertung bleibt bis nach dem Versuch verborgen. So kann die Beobachtung zunächst unabhängig von der Deutung notiert werden.</p>
      </div>
    </aside>

    <main class="card lab">
      <h2>Beobachtungsfenster</h2>
      <div class="stage">
        <div class="timer" id="timer">00:00</div>
        <div class="label" id="setupLabel">Metall und Lösung auswählen</div>

        <div class="beaker-wrap">
          <div class="rim"></div>
          <div class="beaker">
            <div class="liquid" id="liquid"><div class="surface"></div></div>
            <div class="strip" id="strip">
              <div class="deposit" id="deposit"></div>
            </div>
          </div>
        </div>

        <div class="bench"></div>
        <div class="status" id="status">Baue links einen Versuch auf.</div>
      </div>

      <div class="particle-card" id="particleCard" hidden>
        <div class="particle-head">
          <strong>Teilchenebene am Metallrand</strong>
          <span>schematisch, nicht maßstabsgetreu</span>
        </div>
        <canvas id="particleCanvas" width="780" height="230"></canvas>
      </div>

      <div class="result">
        <strong>Beobachtung</strong>
        <div class="obs" id="observation">Führe zuerst den Versuch durch und notiere anschließend deine eigene Beobachtung.</div>
        <div class="equations" id="equations"></div>
      </div>
    </main>
  </div>

  <section class="card notes">
    <h2>Versuchsprotokoll</h2>
    <div class="matrix-wrap">
      <table>
        <thead>
          <tr>
            <th>Metallsalzlösung</th>
            <th>Zinkblech</th>
            <th>Eisenblech</th>
            <th>Kupferblech</th>
            <th>Silberblech</th>
          </tr>
        </thead>
        <tbody id="matrixBody"></tbody>
      </table>
    </div>
    <p class="tiny">Trage „+“ ein, wenn sich ein neues Metall abscheidet. Trage „–“ ein, wenn keine entsprechende sichtbare Reaktion auftritt. Die Animation ist qualitativ: Geschwindigkeit und Stärke von Farbänderungen werden nicht quantitativ simuliert.</p>
    <textarea id="studentNotes" placeholder="Eigene Beobachtungen, z. B. Farbe des Belags oder Veränderung der Lösung …"></textarea>
  </section>
</div>

<script>
const metals = {
  Zn: {name:"Zink", color:"linear-gradient(90deg,#aeb7c2,#e9edf1 48%,#8f9aa6)", ion:"Zn²⁺", ionCharge:2, ionColor:"#d8e1ea"},
  Fe: {name:"Eisen", color:"linear-gradient(90deg,#68717b,#c2c7cc 48%,#545d66)", ion:"Fe²⁺", ionCharge:2, ionColor:"#b9d9b6"},
  Cu: {name:"Kupfer", color:"linear-gradient(90deg,#8f3f24,#da8a62 48%,#73331f)", ion:"Cu²⁺", ionCharge:2, ionColor:"#4fa5df"},
  Ag: {name:"Silber", color:"linear-gradient(90deg,#aab0b8,#f7f9fb 46%,#9ba3ad)", ion:"Ag⁺", ionCharge:1, ionColor:"#e7e8ea"}
};

const solutions = {
  Zn: {name:"Zinksulfat-Lösung", formula:"ZnSO₄(aq)", ion:"Zn²⁺", anion:"SO₄²⁻", anionColor:"#f0e6ba", color:"rgba(235,239,244,.78)"},
  Fe: {name:"Eisen(II)-sulfat-Lösung", formula:"FeSO₄(aq)", ion:"Fe²⁺", anion:"SO₄²⁻", anionColor:"#f0e6ba", color:"rgba(176,213,174,.70)"},
  Cu: {name:"Kupfer(II)-sulfat-Lösung", formula:"CuSO₄(aq)", ion:"Cu²⁺", anion:"SO₄²⁻", anionColor:"#f0e6ba", color:"rgba(62,151,215,.66)"},
  Ag: {name:"Silbernitrat-Lösung", formula:"AgNO₃(aq)", ion:"Ag⁺", anion:"NO₃⁻", anionColor:"#eadfbf", color:"rgba(239,242,246,.78)"}
};

// Vereinfachte Redoxreihe der hier betrachteten Metalle:
// Elektronendonator-Stärke: Zn > Fe > Cu > Ag.
const rank = {Zn:0, Fe:1, Cu:2, Ag:3};

const reactions = {
  "Zn-Fe":{
    deposit:"#5f6265",
    finalLiquid:"rgba(223,232,225,.72)",
    obs:"Auf dem Zinkblech bildet sich allmählich ein dunkelgrauer Eisenbelag. Die blassgrüne Färbung der Lösung wird schwächer.",
    ox:"Zn → Zn²⁺ + 2 e⁻",
    red:"Fe²⁺ + 2 e⁻ → Fe",
    total:"Zn + Fe²⁺ → Zn²⁺ + Fe",
    electronCount:2, productAtoms:1
  },
  "Zn-Cu":{
    deposit:"#b8613f",
    finalLiquid:"rgba(181,211,229,.58)",
    obs:"Auf dem Zinkblech bildet sich ein rotbrauner Kupferbelag. Die blaue Färbung der Lösung wird schwächer.",
    ox:"Zn → Zn²⁺ + 2 e⁻",
    red:"Cu²⁺ + 2 e⁻ → Cu",
    total:"Zn + Cu²⁺ → Zn²⁺ + Cu",
    electronCount:2, productAtoms:1
  },
  "Fe-Cu":{
    deposit:"#b8613f",
    finalLiquid:"rgba(129,190,168,.62)",
    obs:"Auf dem Eisenblech bildet sich ein rotbrauner Kupferbelag. Gleichzeitig wird die blaue Färbung schwächer; durch entstehende Fe²⁺-Ionen kann die Lösung zunehmend blassgrün erscheinen.",
    ox:"Fe → Fe²⁺ + 2 e⁻",
    red:"Cu²⁺ + 2 e⁻ → Cu",
    total:"Fe + Cu²⁺ → Fe²⁺ + Cu",
    electronCount:2, productAtoms:1
  },
  "Zn-Ag":{
    deposit:"#c8ccd1",
    finalLiquid:"rgba(239,242,246,.78)",
    obs:"Auf dem Zinkblech bildet sich ein silbergrauer bis kristalliner Silberbelag. Die Lösung bleibt farblos.",
    ox:"Zn → Zn²⁺ + 2 e⁻",
    red:"2 Ag⁺ + 2 e⁻ → 2 Ag",
    total:"Zn + 2 Ag⁺ → Zn²⁺ + 2 Ag",
    electronCount:2, productAtoms:2
  },
  "Fe-Ag":{
    deposit:"#c8ccd1",
    finalLiquid:"rgba(232,236,228,.74)",
    obs:"Auf dem Eisenblech bildet sich ein silbergrauer bis kristalliner Silberbelag. Eine bestimmte Farbe der Lösung wird hier bewusst nicht als eindeutiges Auswertungsmerkmal verwendet.",
    ox:"Fe → Fe²⁺ + 2 e⁻",
    red:"2 Ag⁺ + 2 e⁻ → 2 Ag",
    total:"Fe + 2 Ag⁺ → Fe²⁺ + 2 Ag",
    electronCount:2, productAtoms:2,
    caveat:"Vereinfachtes Schulmodell: Die Einordnung erfolgt hier über das Redoxpaar Fe²⁺/Fe. In Silbernitrat-Lösung kann Fe²⁺ unter geeigneten Bedingungen durch Ag⁺ teilweise weiter zu Fe³⁺ oxidiert werden."
  },
  "Cu-Ag":{
    deposit:"#c8ccd1",
    finalLiquid:"rgba(104,171,216,.62)",
    obs:"Auf dem Kupferblech bilden sich silbergraue bis kristalline Silberabscheidungen. Die zunächst farblose Lösung färbt sich durch entstehende Cu²⁺-Ionen blau.",
    ox:"Cu → Cu²⁺ + 2 e⁻",
    red:"2 Ag⁺ + 2 e⁻ → 2 Ag",
    total:"Cu + 2 Ag⁺ → Cu²⁺ + 2 Ag",
    electronCount:2, productAtoms:2
  }
};

let selectedMetal = null;
let selectedSolution = null;
let running = false;
let completed = false;
let currentReaction = null;
let particleVisible = false;
let animationId = null;

const $ = s => document.querySelector(s);
const metalOptions = $("#metalOptions");
const solutionOptions = $("#solutionOptions");
const strip = $("#strip");
const liquid = $("#liquid");
const deposit = $("#deposit");
const statusEl = $("#status");
const setupLabel = $("#setupLabel");
const timerEl = $("#timer");
const observation = $("#observation");
const equations = $("#equations");
const particleCard = $("#particleCard");
const canvas = $("#particleCanvas");
const ctx = canvas.getContext("2d");

Object.entries(metals).forEach(([key,m])=>{
  const b=document.createElement("button");
  b.className="choice"; b.dataset.key=key;
  b.innerHTML=`<span>${m.name}blech <small>(${key})</small></span><span class="dot metal-dot" style="background:${m.color}"></span>`;
  b.onclick=()=>selectMetal(key);
  metalOptions.appendChild(b);
});

Object.entries(solutions).forEach(([key,s])=>{
  const b=document.createElement("button");
  b.className="choice"; b.dataset.key=key;
  b.innerHTML=`<span>${s.name}<br><small>${s.formula}</small></span><span class="dot" style="background:${s.color}"></span>`;
  b.onclick=()=>selectSolution(key);
  solutionOptions.appendChild(b);
});

function selectMetal(key){
  if(running) return;
  selectedMetal=key;
  [...metalOptions.children].forEach(b=>b.classList.toggle("active",b.dataset.key===key));
  strip.style.background=metals[key].color;
  clearDeposit();
  refreshSetup();
}
function selectSolution(key){
  if(running) return;
  selectedSolution=key;
  [...solutionOptions.children].forEach(b=>b.classList.toggle("active",b.dataset.key===key));
  liquid.style.background=solutions[key].color;
  clearDeposit();
  refreshSetup();
}
function refreshSetup(){
  completed=false;
  currentReaction=null;
  observation.textContent="Führe zuerst den Versuch durch und notiere anschließend deine eigene Beobachtung.";
  equations.classList.remove("show");
  equations.innerHTML="";
  particleCard.hidden=true;
  particleVisible=false;
  $("#particleBtn").textContent="Teilchenebene";
  timerEl.textContent="00:00";
  if(selectedMetal && selectedSolution){
    setupLabel.textContent=`${metals[selectedMetal].name} in ${solutions[selectedSolution].name}`;
    statusEl.textContent="Versuchsaufbau bereit. Starte den Versuch und beobachte Metallblech und Lösung genau.";
    $("#startBtn").disabled=false;
  } else {
    setupLabel.textContent="Metall und Lösung auswählen";
    statusEl.textContent="Baue links einen Versuch auf.";
    $("#startBtn").disabled=true;
  }
}
function clearDeposit(){ deposit.innerHTML=""; }

function getReaction(){
  if(!selectedMetal || !selectedSolution) return null;
  return reactions[`${selectedMetal}-${selectedSolution}`] || null;
}
function canReact(){
  return selectedMetal && selectedSolution && rank[selectedMetal] < rank[selectedSolution];
}

function addSpecks(color, count=46){
  clearDeposit();
  const rand = mulberry32(hash(`${selectedMetal}-${selectedSolution}`));
  for(let i=0;i<count;i++){
    const s=document.createElement("span");
    s.className="speck";
    const size=3+rand()*8;
    s.style.width=size+"px"; s.style.height=size+"px";
    s.style.left=(3+rand()*86)+"%";
    s.style.top=(18+rand()*75)+"%";
    s.style.background=color;
    s.style.animationDelay=(rand()*2.8)+"s";
    s.style.boxShadow=`0 0 ${1+rand()*3}px rgba(0,0,0,.22)`;
    deposit.appendChild(s);
  }
}
function mulberry32(a){return function(){let t=a+=0x6D2B79F5;t=Math.imul(t^t>>>15,t|1);t^=t+Math.imul(t^t>>>7,t|61);return((t^t>>>14)>>>0)/4294967296}}
function hash(str){let h=2166136261;for(let i=0;i<str.length;i++){h^=str.charCodeAt(i);h=Math.imul(h,16777619)}return h>>>0}

$("#startBtn").onclick=runExperiment;
$("#resetBtn").onclick=resetAll;
$("#particleBtn").onclick=toggleParticles;
$("#equationBtn").onclick=toggleEquations;

function runExperiment(){
  if(running || !selectedMetal || !selectedSolution) return;
  running=true; completed=false;
  currentReaction=getReaction();
  $("#startBtn").disabled=true;
  equations.classList.remove("show");
  particleCard.hidden=true;
  particleVisible=false;
  $("#particleBtn").textContent="Teilchenebene";
  observation.textContent="Beobachte den Versuch. Notiere deine Beobachtung erst nach dem Ablauf.";
  clearDeposit();
  liquid.style.background=solutions[selectedSolution].color;
  let t0=performance.now(), duration=7000;
  let specksAdded=false;

  const tick=(now)=>{
    const p=Math.min(1,(now-t0)/duration);
    timerEl.textContent=`00:${String(Math.round(p*12)).padStart(2,"0")}`;
    if(currentReaction){
      statusEl.textContent = "Der Versuch läuft. Beobachte die Oberfläche des Metallblechs und achte auch auf mögliche Veränderungen der Lösung.";
      if(p>.24 && !specksAdded){ addSpecks(currentReaction.deposit); specksAdded=true; }
      if(p>.42) liquid.style.background=currentReaction.finalLiquid;
    }else{
      statusEl.textContent = "Der Versuch läuft. Beobachte die Oberfläche des Metallblechs und achte auch auf mögliche Veränderungen der Lösung.";
    }
    if(p<1){
      requestAnimationFrame(tick);
    }else{
      finishExperiment();
    }
  };
  requestAnimationFrame(tick);
}

function finishExperiment(){
  running=false; completed=true;
  $("#startBtn").disabled=false;
  statusEl.textContent="Versuch beendet. Halte jetzt deine eigene Beobachtung fest, bevor du die Deutung einblendest.";
  observation.textContent="Beschreibe mit eigenen Worten, was du am Metallblech und an der Lösung beobachtet hast.";
  prepareEquations();
}

function prepareEquations(){
  if(!completed) return;
  if(currentReaction){
    equations.innerHTML=`
      <div class="tiny">Deutung auf Teilchenebene</div>
      <div class="eq"><b>Oxidation:</b> ${currentReaction.ox}</div>
      <div class="eq"><b>Reduktion:</b> ${currentReaction.red}</div>
      <div class="eq"><b>Gesamt:</b> ${currentReaction.total}</div>
      <div class="tiny">${solutions[selectedSolution].anion}-Ionen sind in diesem vereinfachten Reaktionsschema Zuschauerionen und erscheinen deshalb nicht in der verkürzten Ionengleichung.</div>
      ${currentReaction.caveat ? `<div class="tiny" style="margin-top:7px"><b>Modellgrenze:</b> ${currentReaction.caveat}</div>` : ""}`;
  }else{
    equations.innerHTML=`
      <div class="eq"><b>Keine beobachtbare Metallabscheidung.</b></div>
      <div class="tiny">Für diese Kombination wird unter den hier betrachteten Bedingungen keine gerichtete Netto-Redoxreaktion beobachtet, die zur Abscheidung eines neuen Metalls führt.</div>`;
  }
}

function toggleEquations(){
  if(!completed){
    statusEl.textContent="Führe zuerst den Versuch durch.";
    return;
  }
  equations.classList.toggle("show");
}

function toggleParticles(){
  if(!completed){
    statusEl.textContent="Führe zuerst den Versuch durch.";
    return;
  }
  particleVisible=!particleVisible;
  particleCard.hidden=!particleVisible;
  $("#particleBtn").textContent=particleVisible ? "Teilchenebene aus" : "Teilchenebene";
  if(particleVisible) animateParticles();
  else cancelAnimationFrame(animationId);
}

function resetAll(){
  running=false; completed=false; currentReaction=null;
  selectedMetal=null; selectedSolution=null;
  [...document.querySelectorAll(".choice")].forEach(b=>b.classList.remove("active"));
  strip.style.background="linear-gradient(90deg,#c8cfd7,#eef2f5,#aeb7c2)";
  liquid.style.background="rgba(222,231,241,.65)";
  clearDeposit();
  statusEl.textContent="Baue links einen Versuch auf.";
  setupLabel.textContent="Metall und Lösung auswählen";
  timerEl.textContent="00:00";
  observation.textContent="Führe zuerst den Versuch durch und notiere anschließend deine eigene Beobachtung.";
  equations.innerHTML=""; equations.classList.remove("show");
  particleCard.hidden=true; particleVisible=false;
  $("#particleBtn").textContent="Teilchenebene";
  $("#startBtn").disabled=true;
  cancelAnimationFrame(animationId);
}

function animateParticles(){
  const W=canvas.width,H=canvas.height;
  let start=performance.now();
  const m=metals[selectedMetal];
  const s=solutions[selectedSolution];
  const react=!!currentReaction;

  function ion(x,y,r,fill,text,stroke="#4b5563"){
    ctx.beginPath();ctx.arc(x,y,r,0,Math.PI*2);ctx.fillStyle=fill;ctx.fill();
    ctx.lineWidth=1.4;ctx.strokeStyle=stroke;ctx.stroke();
    ctx.fillStyle="#172033";ctx.font="700 13px system-ui";ctx.textAlign="center";ctx.textBaseline="middle";ctx.fillText(text,x,y);
  }
  function electron(x,y){
    ctx.beginPath();ctx.arc(x,y,8,0,Math.PI*2);ctx.fillStyle="#ffe066";ctx.fill();
    ctx.strokeStyle="#7a6110";ctx.stroke();
    ctx.fillStyle="#172033";ctx.font="700 10px system-ui";ctx.textAlign="center";ctx.textBaseline="middle";ctx.fillText("e⁻",x,y+1);
  }
  function depositedAtom(x,y){
    ctx.beginPath();ctx.arc(x,y,14,0,Math.PI*2);
    ctx.fillStyle=currentReaction.deposit;ctx.fill();
    ctx.strokeStyle="rgba(0,0,0,.35)";ctx.stroke();
  }
  function frame(now){
    if(!particleVisible) return;
    const t=(now-start)/1000;
    ctx.clearRect(0,0,W,H);

    ctx.fillStyle="rgba(236,244,249,.78)";
    ctx.fillRect(0,0,W,H);

    // Metallphase links
    ctx.fillStyle="#808996";
    ctx.fillRect(0,0,145,H);
    ctx.fillStyle="rgba(255,255,255,.18)";
    for(let y=18;y<H;y+=34){ctx.fillRect(18+(y%3)*12,y,90,2)}
    ctx.fillStyle="#fff";ctx.font="700 14px system-ui";ctx.textAlign="left";
    ctx.fillText(`${m.name}-Metall`,18,22);

    // Ionen der Ausgangslösung: bei AgNO3 1:1, bei M2+/SO4^2- ebenfalls 1:1.
    const cationColor=metals[selectedSolution].ionColor;
    const cationPts=[[238,140],[332,62],[500,152],[590,94],[718,70]];
    const anionPts=[[250,48],[420,88],[610,48],[690,170],[360,188]];
    cationPts.forEach(([x,y],i)=>{
      ion(x+Math.sin(t*1.2+i)*8,y+Math.cos(t*.9+i)*7,18,cationColor,s.ion);
    });
    anionPts.forEach(([x,y],i)=>{
      ion(x+Math.sin(t+i)*4,y+Math.cos(t*.8+i)*4,18,s.anionColor,s.anion,"#8b7d38");
    });

    if(react){
      const cyc=(t%4)/4;
      const isSilverIon = selectedSolution==="Ag";
      const targets = isSilverIon ? 2 : 1;

      // Reduzierte Metall-Ionen bewegen sich zur Grenzfläche.
      for(let j=0;j<targets;j++){
        const ix=330-(cyc*170);
        const iy=100+j*42+Math.sin(cyc*Math.PI+j)*10;
        ion(ix,iy,19,cationColor,s.ion);

        // Bei Ag+ nimmt jedes Ion ein Elektron auf; bei M2+ nimmt ein Ion zwei auf.
        const electronsForTarget = isSilverIon ? 1 : 2;
        for(let k=0;k<electronsForTarget;k++){
          const idx=isSilverIon ? j : k;
          const eProg=Math.max(0,Math.min(1,(cyc-.55)*3));
          const sx=96+idx*20, sy=104+idx*30;
          const ex=sx+(145-sx)*eProg;
          const ey=sy+(iy-sy)*eProg;
          electron(ex,ey);
        }
        if(cyc>.77) depositedAtom(151,iy);
      }

      // Ein Atom des unedleren Blechs wird zu einem zweifach positiv geladenen Ion.
      const outProg=Math.max(0,Math.min(1,(cyc-.62)*2.6));
      const outX=126+outProg*145, outY=185-outProg*30;
      ion(outX,outY,18,m.ionColor,m.ion);

      ctx.fillStyle="#344054";ctx.font="700 13px system-ui";ctx.textAlign="left";
      ctx.fillText("Elektronen werden an der Metalloberfläche vom unedleren Metall auf Metall-Ionen übertragen.",185,215);
    }else{
      ctx.fillStyle="#344054";ctx.font="700 13px system-ui";ctx.textAlign="left";
      ctx.fillText("Keine gerichtete Netto-Elektronenübertragung mit sichtbarer Metallabscheidung.",185,215);
    }
    animationId=requestAnimationFrame(frame);
  }
  animationId=requestAnimationFrame(frame);
}

// protocol matrix
const tbody=$("#matrixBody");
["Zn","Fe","Cu","Ag"].forEach(sol=>{
  const tr=document.createElement("tr");
  tr.innerHTML=`<td><b>${solutions[sol].name}</b> <span class="tiny">(${solutions[sol].ion})</span></td>`;
  ["Zn","Fe","Cu","Ag"].forEach(m=>{
    const td=document.createElement("td");
    const b=document.createElement("button");
    b.className="cell-btn"; b.textContent="·"; b.dataset.v="";
    b.title="Klicken: + / – / leer";
    b.onclick=()=>{
      if(b.dataset.v===""){b.dataset.v="+";b.textContent="+"}
      else if(b.dataset.v==="+"){b.dataset.v="-";b.textContent="–"}
      else{b.dataset.v="";b.textContent="·"}
    };
    td.appendChild(b);tr.appendChild(td);
  });
  tbody.appendChild(tr);
});
</script>
